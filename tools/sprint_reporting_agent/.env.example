# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# GitHub Personal Access Token with Projects read access.
# Classic token: needs the "read:project" scope (github.com/settings/tokens).
# Fine-grained token: needs "Projects" repository/account permission set to Read-only.
GITHUB_TOKEN=

# The GitHub username that owns the Project (e.g. Sanjaigiri)
GITHUB_PROJECT_OWNER=Sanjaigiri

# The project number from its URL, e.g. github.com/users/<owner>/projects/1 -> 1
GITHUB_PROJECT_NUMBER=1

# Optional: restrict sprint_report.py to a date window (YYYY-MM-DD). An item
# is included if it was created, closed, or moved within this window. Leave
# both blank to report on all items regardless of date. Can be overridden
# per-run with --sprint-start / --sprint-end.
SPRINT_START=
SPRINT_END=
